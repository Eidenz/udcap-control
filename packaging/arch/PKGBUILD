# Maintainer: Eidenz <eidenzgames@gmail.com>
#
# Tauri has no native pacman bundle target (only deb/rpm/appimage), so this
# repackages the Debian build into an Arch package. Point `url` at your repo and
# bump `pkgver` per release; everything else is derived.
pkgname=udcap-control-bin
_appname=udcap-control
pkgver=0.1.0
pkgrel=1
pkgdesc="Hand tracking + Index-controller inputs for Udexreal (UDCAP) gloves (Monado & SteamVR)"
arch=('x86_64')
url="https://github.com/Eidenz/udcap-control"
license=('MIT')
# webkit2gtk-4.1 pulls the GTK/webview stack; libcap/systemd-libs are for the
# bundled udcap-server (hidapi/boost are statically linked in).
depends=('webkit2gtk-4.1' 'gtk3' 'libcap')
provides=("$_appname")
conflicts=("$_appname")
# The bundled udcap-server / driver_udcap.so are prebuilt; don't strip them.
options=('!strip')
source=("$url/releases/download/v${pkgver}/${_appname}_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
	# Extract the .deb (ar archive) then its payload straight into $pkgdir,
	# preserving Tauri's /usr layout (binary, resources, .desktop, icons).
	bsdtar -xf "${_appname}_${pkgver}_amd64.deb" -C "$srcdir"
	bsdtar -xf "$srcdir"/data.tar.* -C "$pkgdir"
}
