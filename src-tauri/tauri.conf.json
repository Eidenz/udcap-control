{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "udcap-control",
  "version": "1.1.0",
  "identifier": "com.eidenz.udcap-control",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UDCAP Control",
        "width": 1200,
        "height": 770,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "mini",
        "title": "UDCAP Control",
        "url": "/mini",
        "width": 380,
        "height": 202,
        "minWidth": 380,
        "minHeight": 202,
        "maxWidth": 380,
        "maxHeight": 202,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/udcap-server": "udcap-server",
      "steamvr-driver/udcap/driver.vrdrivermanifest": "steamvr-driver/udcap/driver.vrdrivermanifest",
      "steamvr-driver/udcap/bin/linux64/driver_udcap.so": "steamvr-driver/udcap/bin/linux64/driver_udcap.so"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
